{
  "name": "plugd",
  "private": true,
  "version": "0.1.0",
  "description": "Plug'd — survivor-like roguelite où l'on tue en refermant des boucles de câble.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:artifact": "vite build -c vite.artifact.config.ts && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
